#!/usr/bin/env bash
# build-native —— 独立编译 Rust Android 原生库（libminibgm_ech.so / libminibgm_torrent.so）
#
# 架构职责边界（Monorepo 构建解耦）：
# - 本脚本是唯一负责调用 cargo-ndk + Android NDK 编译 .so 的入口；
# - Gradle 不再感知 Rust / Cargo / NDK 工具链，只挂载产物目录并校验 .so 存在；
# - 内置基于源码 SHA-256 的指纹缓存（.native-build.stamp）：源码未变且 .so 齐全时毫秒级短路跳过。
set -euo pipefail
cd "$(dirname "$0")/.." || exit 1
REPO_ROOT="$PWD"

# ABI 唯一真源：仓库根 native/abis.txt（ech 与 torrent 共用；客户端常量由 NativeAbiContractTest 对齐）
ABI_LIST_FILE="$REPO_ROOT/native/abis.txt"
STAMP_FILE=".native-build.stamp"

load_abis() {
  if [ ! -f "$ABI_LIST_FILE" ]; then
    echo "[build-native] ❌ 缺少 ABI 真源文件：$ABI_LIST_FILE" >&2
    exit 1
  fi
  ABIS=()
  while IFS= read -r raw_line || [ -n "$raw_line" ]; do
    line=$(printf '%s' "$raw_line" | tr -d '\r' | sed 's/#.*$//' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
    case "$line" in '' ) continue ;; esac
    case "$line" in
      *[!a-z0-9_-]*)
        echo "[build-native] ❌ ABI 真源文件中的条目非法（只允许小写字母/数字/下划线/连字符）：'$line'" >&2
        exit 1
        ;;
    esac
    ABIS+=("$line")
  done < "$ABI_LIST_FILE"
  if [ "${#ABIS[@]}" -eq 0 ]; then
    echo "[build-native] ❌ ABI 真源文件未声明任何 ABI：$ABI_LIST_FILE" >&2
    exit 1
  fi
}
load_abis

usage() {
  cat <<'USAGE'
用法：bash tools/build-native [选项] [ech|torrent...]

选项：
  -f, --force   忽略源码指纹缓存，强制重新调用 cargo-ndk 编译
  -c, --check   仅校验现有 .so 产物与当前源码指纹是否一致（不编译）
  -h, --help    显示本帮助

不指定目标时默认处理全部原生 crate（minibgm-ech 与 minibgm-torrent）。

目标 ABI 集合来自 native/abis.txt（唯一真源，空行与 '#' 注释行忽略）。
USAGE
}

force_build=0
check_only=0
targets=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    -f|--force) force_build=1 ;;
    -c|--check) check_only=1 ;;
    -h|--help) usage; exit 0 ;;
    ech|minibgm-ech) targets+=("ech") ;;
    torrent|minibgm-torrent) targets+=("torrent") ;;
    *) echo "[build-native] ❌ 未知参数：$1" >&2; usage; exit 2 ;;
  esac
  shift
done

if [ "${#targets[@]}" -eq 0 ]; then
  targets=("ech" "torrent")
fi

# ---- 1. 跨平台 SHA-256 工具 ---------------------------------------------------
sha256_stream() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 | awk '{print $1}'
  elif command -v openssl >/dev/null 2>&1; then
    openssl dgst -sha256 | awk '{print $NF}'
  else
    echo "[build-native] ❌ 未找到 sha256sum / shasum / openssl" >&2
    exit 1
  fi
}

# 计算指定 crate + 根 Cargo.toml/Cargo.lock + ABI + API 的确定性指纹
compute_fingerprint() {
  local crate_dir="$1"
  local platform_api="$2"
  {
    printf 'abis=%s\napi=%s\n' "${ABIS[*]}" "$platform_api"
    for f in Cargo.toml Cargo.lock $(find "$crate_dir" -type f \( -name '*.rs' -o -name 'Cargo.toml' -o -name 'build.rs' \) | LC_ALL=C sort); do
      [ -f "$f" ] || continue
      printf 'file=%s\n' "$f"
      cat "$f"
      printf '\0'
    done
  } | sha256_stream
}

verify_artifacts_exist() {
  local out_dir="$1"
  local lib_name="$2"
  local abi
  for abi in "${ABIS[@]}"; do
    local so_path="$out_dir/$abi/$lib_name"
    if [ ! -s "$so_path" ]; then
      return 1
    fi
  done
  return 0
}

# ---- 2. NDK / CMake / Cargo 环境惰性解析（仅当真正需要编译时调用） ------------
NDK_RESOLVED=""
ensure_toolchain() {
  if [ -n "$NDK_RESOLVED" ]; then
    return 0
  fi

  # 补充 ~/.cargo/bin 与常见路径
  if [ -d "$HOME/.cargo/bin" ]; then
    export PATH="$HOME/.cargo/bin:$PATH"
  fi

  if ! command -v cargo >/dev/null 2>&1; then
    echo "[build-native] ❌ 未找到 cargo，请先安装 Rust 工具链：https://rustup.rs" >&2
    exit 1
  fi
  if ! command -v cargo-ndk >/dev/null 2>&1; then
    echo "[build-native] ❌ 未找到 cargo-ndk，请运行：cargo install cargo-ndk --locked" >&2
    exit 1
  fi

  # 解析 SDK 根目录
  local sdk_dir="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-}}"
  if [ -z "$sdk_dir" ] && [ -f "$REPO_ROOT/local.properties" ]; then
    sdk_dir=$(grep -E '^[[:space:]]*sdk\.dir=' "$REPO_ROOT/local.properties" | head -1 | cut -d'=' -f2- | sed 's/\\\\/\\/g; s/\\:/:/g; s/\\=/=/g; s/^[[:space:]]*//; s/[[:space:]]*$//' | tr -d '\r')
  fi

  # 解析可用 NDK 目录：ANDROID_NDK_HOME -> ANDROID_NDK_ROOT -> sdk.dir/ndk/<最高可用版本>
  local candidate=""
  for env_ndk in "${ANDROID_NDK_HOME:-}" "${ANDROID_NDK_ROOT:-}"; do
    if [ -n "$env_ndk" ] && [ -f "$env_ndk/source.properties" ] && [ -d "$env_ndk/toolchains" ]; then
      candidate="$env_ndk"
      break
    fi
  done

  if [ -z "$candidate" ] && [ -n "$sdk_dir" ] && [ -d "$sdk_dir/ndk" ]; then
    for dir in $(ls -1 "$sdk_dir/ndk" 2>/dev/null | sort -V); do
      if [ -f "$sdk_dir/ndk/$dir/source.properties" ] && [ -d "$sdk_dir/ndk/$dir/toolchains" ]; then
        candidate="$sdk_dir/ndk/$dir"
      fi
    done
  fi

  if [ -z "$candidate" ]; then
    echo "[build-native] ❌ 未找到可用的 Android NDK（需包含 source.properties 与 toolchains/）" >&2
    echo "[build-native]    请设置 ANDROID_NDK_HOME 或运行：sdkmanager --install \"ndk;27.2.12479018\"" >&2
    exit 1
  fi

  NDK_RESOLVED="$candidate"
  export ANDROID_NDK_HOME="$NDK_RESOLVED"
  export ANDROID_NDK_ROOT="$NDK_RESOLVED"

  # 补充 SDK 内置 CMake（aws-lc-sys 需要 cmake）
  if ! command -v cmake >/dev/null 2>&1 && [ -n "$sdk_dir" ] && [ -d "$sdk_dir/cmake" ]; then
    for cdir in $(ls -1 "$sdk_dir/cmake" 2>/dev/null | sort -V); do
      if [ -d "$sdk_dir/cmake/$cdir/bin" ]; then
        export PATH="$sdk_dir/cmake/$cdir/bin:$PATH"
      fi
    done
  fi

  # macOS CommandLineTools 兜底
  if [ "$(uname -s)" = "Darwin" ] && [ -d "/Library/Developer/CommandLineTools" ] && [ -z "${DEVELOPER_DIR:-}" ]; then
    export DEVELOPER_DIR="/Library/Developer/CommandLineTools"
  fi
}

# ---- 3. 逐个 Crate 校验或编译 ------------------------------------------------
build_one() {
  local short_name="$1"
  local crate_name="$2"
  local crate_dir="$3"
  local platform_api="$4"
  local out_dir="$5"
  local lib_name="$6"

  # 清理历史遗留在 src/ 下的旧 jniLibs 目录（防止 AGP 重复打包或触发 core:testing 隐式输入报错）
  local legacy_dir
  legacy_dir="$(dirname "$(dirname "$(dirname "$out_dir")")")/src/androidMain/jniLibs"
  if [ -d "$legacy_dir" ]; then
    rm -rf "$legacy_dir"
  fi

  local fingerprint
  fingerprint=$(compute_fingerprint "$crate_dir" "$platform_api")
  local stamp_path="$out_dir/$STAMP_FILE"
  local recorded=""
  if [ -f "$stamp_path" ]; then
    recorded=$(tr -d '[:space:]' < "$stamp_path")
  fi

  if [ "$force_build" = "0" ] && verify_artifacts_exist "$out_dir" "$lib_name" && [ "$recorded" = "$fingerprint" ]; then
    echo "[build-native] ✓ $crate_name 产物已是最新（命中源码指纹缓存）"
    return 0
  fi

  if [ "$check_only" = "1" ]; then
    echo "[build-native] ❌ $crate_name 原生库缺失或与当前 Rust 源码指纹不一致：" >&2
    echo "[build-native]    目录：$out_dir" >&2
    echo "[build-native]    修复：运行 bash tools/build-native" >&2
    exit 1
  fi

  ensure_toolchain
  mkdir -p "$out_dir"

  local abi_args=()
  for abi in "${ABIS[@]}"; do
    abi_args+=("-t" "$abi")
  done

  local extra_args=()
  case "$(uname -s)" in
    MINGW* | MSYS* | CYGWIN*)
      local tmp_target="${TEMP:-/tmp}/minibgm-cargo-target"
      mkdir -p "$tmp_target"
      extra_args+=("--target-dir" "$tmp_target")
      ;;
  esac

  echo "[build-native] 🔨 编译 $crate_name (${ABIS[*]}, API $platform_api, NDK: $(basename "$NDK_RESOLVED"))..."
  cargo ndk "${abi_args[@]}" \
    --platform "$platform_api" \
    -o "$out_dir" \
    build --release --locked -p "$crate_name" \
    ${extra_args[@]+"${extra_args[@]}"}

  if ! verify_artifacts_exist "$out_dir" "$lib_name"; then
    echo "[build-native] ❌ $crate_name 编译完成但未找到预期的 $lib_name 产物（$out_dir）" >&2
    exit 1
  fi

  printf '%s\n' "$fingerprint" > "$stamp_path"
  echo "[build-native] ✅ $crate_name 产物已更新 -> $out_dir"
}

for target in "${targets[@]}"; do
  case "$target" in
    ech)
      build_one \
        "ech" \
        "minibgm-ech" \
        "crates/minibgm-ech" \
        "31" \
        "$REPO_ROOT/core/network/build/ech-native/jniLibs" \
        "libminibgm_ech.so"
      ;;
    torrent)
      build_one \
        "torrent" \
        "minibgm-torrent" \
        "crates/minibgm-torrent" \
        "24" \
        "$REPO_ROOT/core/data/build/torrent-native/jniLibs" \
        "libminibgm_torrent.so"
      ;;
  esac
done
