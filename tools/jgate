#!/usr/bin/env bash
# jgate —— MiniBgm 现代门禁 CLI 启动器
# 逻辑已全面下沉至强类型、跨平台、零依赖的 Rust 原生 CLI (`crates/jgate-cli`)。
set -euo pipefail
cd "$(dirname "$0")/.."

# macOS 兼容性保护：自动选取 CommandLineTools 绕过未配置的 Xcode license
if [ "$(uname -s)" = "Darwin" ] && [ -d "/Library/Developer/CommandLineTools" ] && [ -z "${DEVELOPER_DIR:-}" ]; then
  export DEVELOPER_DIR="/Library/Developer/CommandLineTools"
fi

BIN="target/release/jgate"
NEED_BUILD=0

if [ ! -f "$BIN" ]; then
  NEED_BUILD=1
elif [ -n "$(find crates/jgate-cli/src crates/jgate-cli/Cargo.toml -newer "$BIN" 2>/dev/null)" ]; then
  NEED_BUILD=1
fi

if [ "$NEED_BUILD" = "1" ]; then
  echo "[jgate] 正在构建门禁 CLI 原生二进制..."
  cargo build --release -p jgate --quiet
fi

exec "$BIN" "$@"
