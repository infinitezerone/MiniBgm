#!/usr/bin/env bash
# jgate —— 提交前置验证门（AGENTS.md 唯一认可的提交前置步骤）
# 流程：素材体积 → Rust 门禁（触及 crates/ 时：fmt/clippy/test，与 CI 逐字一致）→
#       spotlessApply（触及模块）→ 架构红线 + 触及模块测试（含 :app 单测）+ :app:assembleDebug → 测试结果真实性校验
# "绿≠测过"由最后的 XML 校验机械保证：tests>0 且 failures==0 且 errors==0，否则退出非零。
#
# 验证目标是"改动"，不是"全仓库"：
#   ① 工作副本 @ 有改动   → 验证工作副本（主路径：改完就跑）
#   ② @ 干净、@- 有改动   → 验证最近一次提交（jj commit 之后复跑，不再退化为全量）
#   ③ 改动触及跨切面路径   → 提升为全量（build-logic / gradle / 根构建脚本 / 版本目录）
#   ④ 以上都不成立         → 明确报错要求 --all 或显式模块：既不静默放行（假绿），也不静默全量（慢）
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

usage() {
  cat <<'USAGE'
用法：bash tools/jgate [选项] [模块...]

选项：
  -a, --all     强制验证全部模块（跨切面改动、PR 前）
  -n, --plan    只打印本次验证目标与将要执行的 gradle 任务，不执行任何命令（别名 --dry-run）
  -h, --help    显示本帮助

模块可显式指定（`feature/user`、`feature:user`、`:feature:user` 均可）；一旦指定就不再自动推断。

不带参数时按改动自动推断：工作副本 @ → 最近一次提交 @- → 报错。
USAGE
}

plan_only=0
force_all=0
explicit_all=0
cli_modules=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    -a|--all) force_all=1; explicit_all=1 ;;
    -n|--plan|--dry-run) plan_only=1 ;;
    -h|--help) usage; exit 0 ;;
    --) shift; while [ "$#" -gt 0 ]; do cli_modules+=("$1"); shift; done; break ;;
    -*) echo "[jgate] ❌ 未知选项：$1" >&2; usage; exit 2 ;;
    *) cli_modules+=("$1") ;;
  esac
  shift
done

# 自愈：确保本 clone 的 git 钩子已接线（其他机器 clone 后无需人工记得跑 setup.sh）
if [ "$(git config core.hooksPath || true)" != "tools/githooks" ]; then
  git config core.hooksPath tools/githooks && echo "[jgate] 已自动接线 core.hooksPath → tools/githooks"
fi

normalize_module() {
  printf '%s' "${1#:}" | tr ':' '/'
}

all_modules() {
  sed -n 's/^include(":\(.*\)")$/\1/p' settings.gradle.kts | tr ':' '/'
}

# ---- 1. 确定验证目标 ----------------------------------------------------------
# 工作副本改动优先；干净时退到最近一次提交（@-），而不是全量——提交后复跑是高频动作，
# 退化为全量等于每次都要重新 hash 19 个模块的全部源码。
work_diff=$(jj diff --summary 2>/dev/null || true)
diff_summary=""
target_desc=""

if [ "$force_all" = "1" ]; then
  target_desc="全量（--all）"
elif [ "${#cli_modules[@]}" -gt 0 ]; then
  target_desc="显式指定模块"
elif [ -n "$work_diff" ]; then
  diff_summary="$work_diff"
  target_desc="工作副本 @"
else
  diff_summary=$(jj diff --summary -r @- 2>/dev/null || true)
  if [ -n "$diff_summary" ]; then
    target_desc="最近一次提交 @-（工作副本无改动）"
  else
    echo "[jgate] ❌ 工作副本与最近一次提交都没有改动，没有可验证的内容" >&2
    echo "[jgate]    强制全量：bash tools/jgate --all      指定模块：bash tools/jgate feature/user" >&2
    exit 1
  fi
fi

# 改动路径（jj 在 Windows 输出反斜杠，统一成 /）
paths=""
if [ -n "$diff_summary" ]; then
  paths=$(printf '%s\n' "$diff_summary" | awk '{print $NF}' | sed 's/\\/\//g')
fi

# ---- 2. 跨切面与基础层改动 → 提升为全量 ------------------------------------
# 基础数据层（model/common/data/network/database/datastore）具有向下传染性；
# 构建脚本、版本目录改动影响所有模块。提升为全量以防下游业务模块静默漏测。
cross_re='^(build-logic/|gradle/|gradle\.properties$|settings\.gradle\.kts$|[^/]*\.gradle\.kts$|core/(model|common|data|network|database|datastore)/)'
if [ "$force_all" != "1" ] && [ -n "$paths" ] && printf '%s\n' "$paths" | grep -qE "$cross_re"; then
  force_all=1
  target_desc="$target_desc ＋ 跨切面/底层核心改动 → 提升为全量"
fi

# ---- 2b. Rust 门禁触发判定 ----------------------------------------------------
# crates/ 的 fmt/clippy/test 曾只存在于 CI，本地 jgate 不查 → clippy 破坏可以一路
# 推上 main 和 release tag（2026-10-01 v0.4.0 发布失败即此因）。触及 crates/ 或
# 根 Cargo 清单时触发；--all 视为全量验证同样触发。命令与 ci.yml Rust job 逐字一致。
need_rust=0
if [ "$explicit_all" = "1" ]; then
  need_rust=1
elif [ -n "$paths" ] && printf '%s\n' "$paths" | grep -qE '^(crates/|Cargo\.toml$|Cargo\.lock$)'; then
  need_rust=1
fi

# ---- 3. 解析模块集合 ----------------------------------------------------------
modules=()
if [ "$force_all" = "1" ]; then
  while IFS= read -r m; do [ -n "$m" ] && modules+=("$m"); done < <(all_modules)
elif [ "${#cli_modules[@]}" -gt 0 ]; then
  for raw in "${cli_modules[@]}"; do
    modules+=("$(normalize_module "$raw")")
  done
else
  while IFS= read -r m; do [ -n "$m" ] && modules+=("$m"); done < <(
    printf '%s\n' "$paths" | sed -E 's#^app(/.*)?$#app#; s#^((core|feature|sync)/[^/]+).*#\1#' | grep -E '^(app|core|feature|sync)' | sort -u
  )
fi

# ---- 4. 任务清单 --------------------------------------------------------------
spotless_targets=()
for m in "${modules[@]+"${modules[@]}"}"; do
  [ -f "$m/build.gradle.kts" ] && spotless_targets+=(":${m//\//:}:spotlessApply")
done

test_tasks=()
for m in "${modules[@]+"${modules[@]}"}"; do
  # :app 不再跳过：装配门 :app:assembleDebug 只编译、不跑测试，历史上因此让破损的
  # AppModuleTest 静默存活过一整个提交周期。:app 是 Android-only 模块，走 testDebugUnitTest。
  [ -f "$m/build.gradle.kts" ] || continue
  task_path=":${m//\//:}"
  if grep -q "minibgm.kmp" "$m/build.gradle.kts"; then
    test_tasks+=("${task_path}:testAndroid")
  else
    test_tasks+=("${task_path}:testDebugUnitTest")
  fi
done

# 红线宿主 :core:testing 每次都跑（架构规则测试）；装配门也每次都跑（最上层编译）。
# 去重：:core:testing 既可能自己就是触及模块，重复入图会让 gradle 报 "task may only be used once" 之外的噪音。
# 不用关联数组——macOS 自带 bash 3.2 没有 declare -A，而本脚本要在其他机器 clone 后直接可用。
gradle_tasks=()
append_task() {
  local t
  for t in "${gradle_tasks[@]+"${gradle_tasks[@]}"}"; do
    [ "$t" = "$1" ] && return 0
  done
  gradle_tasks+=("$1")
}
append_task ":core:testing:testAndroid"
for t in "${test_tasks[@]+"${test_tasks[@]}"}"; do append_task "$t"; done
append_task ":app:assembleDebug"
if [ "$explicit_all" = "1" ]; then
  # 显式全量验证（--all）时与 CI 完全对齐：加入 R8 混淆验证与 CRAP 代码风险度量
  append_task ":app:assembleRelease"
  append_task ":core:testing:crapCheck"
fi

echo "[jgate] 验证目标：$target_desc"
if [ "${#modules[@]}" -eq 0 ]; then
  echo "[jgate] ⚠️ 改动不触及任何 Gradle 模块（如只改了 docs/、tools/）→ 跳过 spotless 与模块测试，只跑架构红线 + 装配门"
fi
echo "[jgate] 模块 ${#modules[@]} 个：${modules[*]:-（无）}"
echo "[jgate] 将执行：${gradle_tasks[*]}"
if [ "$need_rust" = "1" ]; then
  echo "[jgate] 将执行（Rust）：cargo fmt --all --check → cargo clippy --locked -p minibgm-ech --all-targets -- -D warnings → cargo test --locked -p minibgm-ech"
fi

if [ "$plan_only" = "1" ]; then
  echo "[jgate] --plan：以上仅为计划，未执行任何命令"
  exit 0
fi

fail=0
stamp=$(mktemp)
touch "$stamp"

run_gradle() {
  echo "[jgate] gradle $*"
  local start=$SECONDS
  ./gradlew "$@" --console=plain || { echo "[jgate] ❌ gradle $* 失败"; fail=1; return 1; }
  echo "[jgate]   ↳ $((SECONDS - start))s"
}

# ---- 素材体积门 ---------------------------------------------------------------
# 截图是唯一会让仓库历史**不可逆**膨胀的资产：git 保留每一版，误提交一张 1 MB 的
# screencap 原始输出，之后只能靠改写历史才能清掉。所以在提交前就拦住。
# 放在 spotless 之前——这一步不依赖 gradle，几毫秒就能判死。
#
# 为什么不是 git pre-commit 钩子：jj 不运行 git 钩子（见 AGENTS.md），钩子对本仓库无效。
echo "[jgate] 1/5 素材体积"
asset_limit_kb=200
asset_total_limit_kb=1024
if [ -n "$paths" ]; then
  asset_total_kb=0
  asset_bad=""
  while IFS= read -r p; do
    case "$p" in
      *.png | *.PNG | *.jpg | *.JPG | *.jpeg | *.JPEG | *.gif | *.GIF | *.bmp | *.BMP | *.webp | *.WEBP) ;;
      *) continue ;;
    esac
    [ -f "$p" ] || continue
    kb=$(((($(wc -c <"$p") + 1023)) / 1024))
    asset_total_kb=$((asset_total_kb + kb))
    if [ "$kb" -gt "$asset_limit_kb" ]; then
      asset_bad="${asset_bad}  ${kb} KB  ${p}
"
    fi
  done <<<"$paths"
  if [ -n "$asset_bad" ]; then
    echo "[jgate] ❌ 以下素材单张超过 ${asset_limit_kb} KB，先压缩再提交：" >&2
    printf '%s' "$asset_bad" >&2
    echo "[jgate]    修法：压成 800px 宽的 WebP（README 表格里约 380px 显示宽度，2 倍图够用）" >&2
    exit 1
  fi
  if [ "$asset_total_kb" -gt "$asset_total_limit_kb" ]; then
    echo "[jgate] ❌ 本次改动涉及的素材合计 ${asset_total_kb} KB，超过 ${asset_total_limit_kb} KB 上限" >&2
    echo "[jgate]    修法：压成 800px 宽的 WebP（README 表格里约 380px 显示宽度，2 倍图够用）" >&2
    exit 1
  fi
  echo "[jgate]   ↳ 素材合计 ${asset_total_kb} KB（单张上限 ${asset_limit_kb} KB）"
fi

echo "[jgate] 2/5 Rust 门禁（crates/）"
# 放在 spotless 之前：不依赖 gradle/daemon，fmt 秒级、clippy 分钟级就能判死，
# 不必等 Android 构建跑完才暴露 Rust 侧的破坏。
if [ "$need_rust" != "1" ]; then
  echo "[jgate]   ↳ 改动未触及 crates/，跳过"
else
  if ! command -v cargo >/dev/null 2>&1; then
    echo "[jgate] ❌ 找不到 cargo——crates/ 改动需要 Rust 工具链（rustup + stable）" >&2
    exit 1
  fi
  # Windows（Git Bash）：MSVC 工具链的标准运行环境是完整的 vcvars64 环境。实测任何
  # "只导入部分变量"的做法都会踩坑——cl.exe 的 DLL（c1.dll/c2.dll）按 PATH 定位，
  # INCLUDE 缺 UCRT 段找不到 stdint.h，半套变量在 cc-rs/Ninja 调起时报 D8050 或静默
  # exit 2（2026-10 排查实锤）。标准做法即"在 vcvars64 环境内跑构建"：每条 cargo 命令
  # 包进一次性 bat 执行。中文代码页（936）还会对 aws-lc 头文件报 C4819，叠加 -WX 判死，
  # 故在 bat 内注入 CL=-utf-8（cmd 侧设置，不经 MSYS 转换）。
  rust_in_vcvars=0
  vsroot=""
  case "$(uname -s)" in
    MINGW* | MSYS* | CYGWIN*)
      # bash 的 `_`（上一条命令）传入 cl.exe 会让 MSVC 前端静默 exit 2（二分定位实锤，
      # 2026-10）。unset 无效——bash 每次执行外部命令都会重设 `_`，必须在 exec 时用
      # `env -u _` 移除（见 run_cargo）。
      :
      vswhere="/c/Program Files (x86)/Microsoft Visual Studio/Installer/vswhere.exe"
      if [ -f "$vswhere" ]; then
        vsroot=$("$vswhere" -latest -products '*' -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath 2>/dev/null | head -1 | tr -d '\r')
        [ -n "$vsroot" ] && rust_in_vcvars=1
      fi
      ;;
  esac
  run_cargo() {
    if [ "$rust_in_vcvars" != "1" ]; then
      env -u _ "$@"
      return $?
    fi
    local bat rc
    bat=$(mktemp /tmp/jgate-cargo-XXXXXX.bat)
    {
      echo '@echo off'
      echo "call \"$(cygpath -w "$vsroot")\\VC\\Auxiliary\\Build\\vcvars64.bat\" >nul 2>&1"
      echo "cd /d \"$(cygpath -w "$PWD")\""
      echo 'set CL=-utf-8'
      echo "$*"
    } >"$bat"
    env -u _ cmd //c "$(cygpath -w "$bat")"
    rc=$?
    rm -f "$bat"
    return $rc
  }
  start=$SECONDS
  run_cargo cargo fmt --all --check || { echo "[jgate] ❌ cargo fmt 未通过（修法：cargo fmt --all）"; exit 1; }
  echo "[jgate]   ↳ fmt $((SECONDS - start))s"

  cl_log=$(mktemp /tmp/jgate-clippy-XXXXXX.log)
  run_cargo cargo clippy --locked -p minibgm-ech --all-targets -- -D warnings >"$cl_log" 2>&1
  cl_rc=$?
  cat "$cl_log"
  echo "[jgate]   ↳ clippy $((SECONDS - start))s"

  if [ "$cl_rc" != "0" ]; then
    if grep -qF 'failed to run custom build command for `aws-lc-sys' "$cl_log"; then
      echo "[jgate] ❌ cargo clippy 失败（aws-lc-sys 构建异常）："
      echo "[jgate]    常见原因 1：Windows 目录下被沙盒标记了低完整性级别（0xc0000142）"
      echo "[jgate]               修法（管理员 PowerShell）："
      echo "[jgate]               icacls \"$PWD\" /setintegritylevel \"(OI)(CI)M\" /t /c /q"
      echo "[jgate]               icacls \"$PWD\" /remove:d Everyone /t /c /q"
      echo "[jgate]    常见原因 2：缺少 NASM 或 MSVC C++ 构建工具（确保 nasm.exe 在 PATH 中）"
    else
      echo "[jgate] ❌ cargo clippy 未通过（-D warnings，与 CI 同门禁）"
    fi
    rm -f "$cl_log"
    exit 1
  fi
  rm -f "$cl_log"

  start=$SECONDS
  run_cargo cargo test --locked -p minibgm-ech || { echo "[jgate] ❌ cargo test 未通过"; exit 1; }
  echo "[jgate]   ↳ test $((SECONDS - start))s"
  rust_ran=1
fi

echo "[jgate] 3/5 spotless"
# 全量 spotlessApply 即使全部 UP-TO-DATE 也要 hash 18 个模块的全部源码（实测 ~16s）；
# 触及模块级调用把这一阶段压到几秒。只有"工作副本真有改动"才需要格式化——
# 目标是 @- 时工作副本本身干净，格式化是空转。
if [ -z "$work_diff" ]; then
  echo "[jgate] 工作副本无改动，跳过 spotless"
elif [ "${#spotless_targets[@]}" -gt 0 ]; then
  run_gradle "${spotless_targets[@]}" -q
else
  echo "[jgate] 触及路径均不在模块内，跳过 spotless"
fi

echo "[jgate] 4/5 架构红线 + 触及模块测试 + 装配门"
# 三项合并到同一次 gradle 调用，省去一次 daemon/配置缓存往返；任务间无依赖，顺序无关。
run_gradle "${gradle_tasks[@]}"

echo "[jgate] 5/5 测试结果真实性校验"
checked=0
for m in "${modules[@]+"${modules[@]}"}"; do
  [ -f "$m/build.gradle.kts" ] || continue
  m_new_xmls=0
  while IFS= read -r xml; do
    [ -n "$xml" ] || continue
    m_new_xmls=$((m_new_xmls + 1))
    checked=$((checked + 1))
    counts=$(grep -o 'tests="[0-9]*" skipped="[0-9]*" failures="[0-9]*" errors="[0-9]*"' "$xml" | head -1)
    tests=$(echo "$counts" | sed -n 's/.*tests="\([0-9]*\)".*/\1/p')
    failures=$(echo "$counts" | sed -n 's/.*failures="\([0-9]*\)".*/\1/p')
    errors=$(echo "$counts" | sed -n 's/.*errors="\([0-9]*\)".*/\1/p')
    if [ "${failures:-0}" != "0" ] || [ "${errors:-0}" != "0" ]; then
      echo "[jgate] ❌ $xml：failures=$failures errors=$errors"
      fail=1
    elif [ "${tests:-0}" = "0" ]; then
      echo "[jgate] ❌ $xml：tests=0（空跑/测试源集未收集）"
      fail=1
    fi
  done < <(find "$m" -path "*/build/test-results/*" -name "TEST-*.xml" -newer "$stamp" 2>/dev/null)

  # 防假绿闭环：若本轮没有新增 XML，检查是否属于任务空跑（NO-SOURCE）或历史有无测试记录
  if [ "$m_new_xmls" = "0" ]; then
    total_xml_count=$(find "$m" -path "*/build/test-results/*" -name "TEST-*.xml" 2>/dev/null | wc -l)
    test_src_count=$(find "$m/src" -type f \( -name "*Test.kt" -o -name "*Tests.kt" \) 2>/dev/null | wc -l)
    if [ "$total_xml_count" -eq 0 ] && [ "$test_src_count" -gt 0 ]; then
      echo "[jgate] ❌ $m：发现 $test_src_count 个测试源码文件，但从未生成测试结果 XML（任务 NO-SOURCE 或测试源集配置错误）"
      fail=1
    fi
  fi
done

if [ "$checked" = "0" ] && [ "${#test_tasks[@]}" -gt 0 ] && [ "$fail" = "0" ]; then
  echo "[jgate] ℹ️ 测试任务无新增结果文件——任务均 UP-TO-DATE 并沿用上次结果"
fi

rm -f "$stamp"
if [ "$fail" != "0" ]; then
  echo "[jgate] ❌ 验证门未通过，禁止提交"
  exit 1
fi
# 0 份结果时不说"0 份结果校验"就收尾——那半个句子本身就是假绿信号。
rust_note=""
if [ "$need_rust" = "1" ] && [ "${rust_ran:-0}" = "1" ]; then
  rust_note="Rust / "
fi
if [ "$checked" = "0" ]; then
  echo "[jgate] ✅ 验证门通过（素材 / ${rust_note}spotless / 红线 / ${#test_tasks[@]} 个模块测试 / 装配）— 本轮 0 份新增结果，任务全部 UP-TO-DATE，沿用上次结果"
else
  echo "[jgate] ✅ 验证门通过（素材 / ${rust_note}spotless / 红线 / ${#test_tasks[@]} 个模块测试 / 装配 / $checked 份结果校验）"
fi
